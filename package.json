{
  "name": "horizon-timer",
  "version": "0.1.0",
  "description": "Invisible Support productivity tool for the neurodivergent brain",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build:win": "electron-builder --win portable",
    "test": "node --test 'tests/**/*.test.js'"
  },
  "keywords": [
    "adhd",
    "productivity",
    "timer",
    "pomodoro",
    "focus"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "auto-launch": "^5.0.6",
    "chart.js": "^4.5.1"
  },
  "build": {
    "appId": "com.horizon.timer",
    "productName": "Horizon",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico"
    },
    "portable": {
      "artifactName": "HorizonTimer-Portable.exe"
    }
  }
}
